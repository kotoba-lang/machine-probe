;; kotoba-lang/machine-probe — T5 provider: read a real machine, emit a
;; :measured descriptor. The effect half of the machine contract, which
;; declares :must-not [:probe-hardware] for exactly this reason.
{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/machine
        {:git/url "https://github.com/kotoba-lang/machine.git"
         :git/sha "e7235657c6f6bc4e43e7e6126c1c0912e8dbf5f4"}
        ;; machine.bench closes the loop: layout predicts, this measures,
        ;; perfgate rules. Both are :library/:assurance, which an :assurance
        ;; repo may depend on.
        io.github.kotoba-lang/layout
        {:git/url "https://github.com/kotoba-lang/layout.git"
         :git/sha "333914518e9d6e3c171552ae876d21c6dd7a673f"}
        io.github.kotoba-lang/traversal
        {:git/url "https://github.com/kotoba-lang/traversal.git"
         :git/sha "792a339a575bc8cfb97ac6ac57a7969660360302"}
        io.github.kotoba-lang/perfgate
        {:git/url "https://github.com/kotoba-lang/perfgate.git"
         :git/sha "02f548586f45c8b04c53f2782da5a1b633c95596"}}
 :aliases
 {:test {:extra-paths ["test" "test/resources"]
        ;; test-only: the composition test drives the whole T5 chain
        ;; through one descriptor, and consumers should not inherit
        ;; paging/ioplan/gpu just to use the probe.
        :extra-deps {io.github.kotoba-lang/paging
         {:git/url "https://github.com/kotoba-lang/paging.git"
          :git/sha "9ab25a5b2baf6c672cbb721bf694e1f81d097035"}
         io.github.kotoba-lang/ioplan
         {:git/url "https://github.com/kotoba-lang/ioplan.git"
          :git/sha "7cefe9ac119b3967ac7c6273c5cfa4decfaf1774"}
         io.github.kotoba-lang/gpu
         {:git/url "https://github.com/kotoba-lang/gpu.git"
          :git/sha "a4a8173c23ba8389e63849109e93ad6a791486fc"}
         io.github.cognitect-labs/test-runner
         {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :probe {:main-opts ["-m" "machine.probe-cli"]}
  :bench {:main-opts ["-m" "machine.bench-cli"]}
  :scaling {:main-opts ["-m" "machine.scaling-cli"]}
  :tiling {:main-opts ["-m" "machine.tiling-cli"]}
  :tlb {:main-opts ["-m" "machine.tlb-cli"]}
  :unrolled {:main-opts ["-m" "machine.unrolled-cli"]}
  :calibrate {:main-opts ["-m" "machine.calibrate-cli"]}
  :curve {:main-opts ["-m" "machine.curve-cli"]}
  :perarm {:jvm-opts ["-Xmx12g"] :main-opts ["-m" "machine.perarm-cli"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
